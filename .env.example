# --- Supabase (optional in dev) ---
# When these are set, the app uses Supabase for storage + auth.
# When unset, the app runs fully offline against the seed bank with
# progress persisted to localStorage (see src/lib/data/provider.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (server-only, used by /api/generate-items) ---
# NEVER expose to the client bundle.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
